# Copy this file to ".env" (same folder) and fill in your real values. ".env" is git-ignored; this example is not.
# Plain KEY=value lines: no quotes, and double any backslash in a value.
DB_PASSWORD=your-mysql-password
# BANK_SERVICE_URL=http://localhost:8080
# Must be the EXACT same value as SERVICE_API_KEY in the Bank app's own .env.
SERVICE_API_KEY=change-this-service-key
